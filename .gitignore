# Build artifacts
SCRAPs/scraps
SCRAPs/*.o

# In-tree test-case run outputs (regenerated whenever a test case is
# executed manually; INPUT and POSCAR are tracked, everything else is not)
tests/*/scraps
tests/*/scraps.log
tests/*/SCRAPS.vasp

# Notebook output dirs (regenerated by jupyter execute)
notebooks/nb*/
notebooks/*.cif
notebooks/*.poscar
notebooks/POSCAR_*
notebooks/.ipynb_checkpoints/

# Python
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.venv/
.ruff_cache/
.mypy_cache/

# Editor
.vscode/
.idea/
*.swp
*.swo
.DS_Store

# Build outputs
docs/*.aux
docs/*.log
docs/*.out
docs/*.toc

# JOSS paper local preview (rebuildable from paper.md + paper.bib)
paper/paper.pdf
paper/*.aux
paper/*.log
paper/*.out

# Research-case per-cell run outputs (rebuildable; keep only the
# summary JSON + matplotlib figure that the markdown embeds)
docs/research_cases/results/*/POSCAR
docs/research_cases/results/*/INPUT
docs/research_cases/results/*/SCRAPS.vasp
docs/research_cases/results/*/scraps.log
docs/research_cases/results/*/scraps
docs/research_cases/results/*/sqs.cif
