# Build artifacts
SCRAPs/scraps
SCRAPs/*.o

# In-tree test-case run outputs (regenerated whenever a test case is
# executed manually; INPUT and POSCAR are tracked, everything else is not)
tests/*/scraps
tests/*/scraps.log
tests/*/SCRAPS.vasp

# Notebook output dirs (regenerated by jupyter execute)
notebooks/nb*/
notebooks/*.cif
notebooks/.ipynb_checkpoints/

# Python
__pycache__/
*.pyc
*.pyo
.pytest_cache/

# Editor
.vscode/
.idea/
*.swp
*.swo
.DS_Store

# Build outputs
docs/*.aux
docs/*.log
docs/*.out
docs/*.toc
